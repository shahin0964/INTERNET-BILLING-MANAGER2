# Server Environment Configuration
PORT=5000
NODE_ENV=production

# PostgreSQL Connection String
# Example local VPS: postgresql://postgres:your_password@localhost:5432/ibm_db
# Example Supabase/Neon: postgresql://postgres:your_password@db.xxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ibm_db

# Security & JWT Secrets
JWT_SECRET=ibm_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# MikroTik Default Connection (Optional)
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASS=

# CORS Allowed Origins
CORS_ORIGIN=*
